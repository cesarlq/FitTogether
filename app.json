{
  "expo": {
    "name": "FitTogether",
    "slug": "fittogether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f8f6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fittogether.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FitTogether necesita acceso a tu cámara para tomar fotos de tus comidas.",
        "NSPhotoLibraryUsageDescription": "FitTogether necesita acceso a tu galería para seleccionar fotos de tus comidas."
      }
    },
    "android": {
      "package": "com.fittogether.app",
      "adaptiveIcon": {
        "backgroundColor": "#f5f8f6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "eee1541b-4b56-49f5-9f59-da7ed96a5643"
      }
    },
    "owner": "cesarlq",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eee1541b-4b56-49f5-9f59-da7ed96a5643"
    }
  }
}
